{
  "name": "Question Copy",
  "description": "Click floating icon to copy question content to clipboard",
  "urlPatterns": ["/assessments/assignments/"],
  "defaultConfig": {
    "enabled": true,
    "iconSize": 48,
    "iconOpacity": 0.9,
    "showNotification": true
  },
  "uiConfig": {
    "showToggle": true,
    "fields": [
      {
        "type": "number",
        "id": "iconSize",
        "label": "Icon Size",
        "default": 48,
        "min": 32,
        "max": 80
      },
      {
        "type": "range",
        "id": "iconOpacity",
        "label": "Icon Opacity",
        "default": 0.9,
        "min": 0.5,
        "max": 1,
        "step": 0.1
      },
      {
        "type": "checkbox",
        "id": "showNotification",
        "label": "Show Notification",
        "default": true
      }
    ]
  }
}
