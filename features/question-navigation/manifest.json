{
  "name": "Question Navigation",
  "description": "Use keyboard keys to navigate between questions",
  "urlPatterns": ["/assessments/assignments/"],
  "defaultConfig": {
    "enabled": true,
    "leftKey": "ArrowLeft",
    "rightKey": "ArrowRight"
  },
  "uiConfig": {
    "showToggle": true,
    "fields": [
      {
        "type": "key",
        "id": "leftKey",
        "label": "Previous Question Key",
        "default": "ArrowLeft"
      },
      {
        "type": "key",
        "id": "rightKey",
        "label": "Next Question Key",
        "default": "ArrowRight"
      }
    ]
  },
  "behaviorConfig": {
    "hotReloadOnConfigChange": false,
    "reloadOnUrlChange": true,
    "supportsDynamicToggle": true
  }
}
