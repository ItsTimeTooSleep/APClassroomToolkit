{
  "name": "Performance Navigation",
  "description": "Use keyboard keys to navigate between performance questions",
  "urlPatterns": ["/assessments/results/"],
  "defaultConfig": {
    "enabled": true,
    "leftKey": "ArrowLeft",
    "rightKey": "ArrowRight"
  },
  "uiConfig": {
    "showToggle": true,
    "fields": [
      {
        "type": "key",
        "id": "leftKey",
        "label": "Previous Response Key",
        "default": "ArrowLeft"
      },
      {
        "type": "key",
        "id": "rightKey",
        "label": "Next Response Key",
        "default": "ArrowRight"
      }
    ]
  },
  "behaviorConfig": {
    "hotReloadOnConfigChange": false,
    "reloadOnUrlChange": true,
    "supportsDynamicToggle": true
  }
}
