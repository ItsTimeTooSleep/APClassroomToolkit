{
  "manifest_version": 3,
  "name": "AP Classroom Toolkit",
  "version": "1.0",
  "description": "Enhance AP Classroom with arrow key navigation and number key selection",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AP Classroom Toolkit"
  },
  "content_scripts": [
    {
      "matches": ["https://apclassroom.collegeboard.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "features/features.json",
        "features/*/manifest.json",
        "features/*/index.js"
      ],
      "matches": ["https://apclassroom.collegeboard.org/*"]
    }
  ]
}
