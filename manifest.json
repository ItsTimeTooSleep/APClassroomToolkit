{
  "manifest_version": 3,
  "name": "AP Classroom Arrow Control",
  "version": "1.0",
  "description": "Use left/right arrow keys to navigate between questions in AP Classroom",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://apclassroom.collegeboard.org/*/assessments/assignments/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}